{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/product.schema.json",
  "title": "Product",
  "description": "A product from Acme catalog",
  "type": "object",
  "properties": {
    "productId": {
      "description": "Unique identifier for product",
      "type": "integer",
      "multipleOf": 5
    },
    "productName": {
      "description": "Name of product",
      "type": "string",
      "minLength": 3,
      "maxLength": 40
    },
    "price": {
      "description": "Price of product",
      "type": "number",
      "exclusiveMinimum": 0,
      "multipleOf": 0.05,
      "default": 1.99
    },
    "tags": {
      "description": "Tags for product",
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["electronics", "books", "clothing"]
      },
      "minItems": 1,
      "uniqueItems": true,
      "default": ["books", "electronics"]
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "length": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "required": ["length", "width", "height"]
    }
  },
  "required": ["productId", "productName", "price"]
}
